# Emiglio API Keys
# Copy to .env and fill in your keys. No EMIGLIO_ prefix needed for API keys.

# Anthropic (used by brain/LangGraph agent)
ANTHROPIC_API_KEY=

# ElevenLabs (TTS)
ELEVENLABS_API_KEY=

# LangSmith (optional — tracing)
LANGSMITH_API_KEY=

# Server STT URL (optional — Docker Whisper service)
SERVER_STT_URL=
