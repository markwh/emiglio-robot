[Unit]
Description=Emiglio Robot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/emiglio-robot
Environment=EMIGLIO_HARDWARE_MODE=real
Environment=EMIGLIO_SERVER_STT_URL=http://homeserver.local:8001
Environment=EMIGLIO_SERVER_TTS_URL=http://homeserver.local:8002
Environment=EMIGLIO_SERVER_BRAIN_URL=http://homeserver.local:8003
ExecStart=/home/pi/.local/bin/uv run python -m emiglio
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
